        <mxCell id="emb" value="Generación de embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="470" y="90" width="170" height="70" as="geometry" />
