        <mxCell id="db" value="BBDD vectorial" style="shape=cylinder3;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
