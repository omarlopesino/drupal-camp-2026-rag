<mxfile host="drawio">
  <diagram id="rag-agente" name="RAG agente">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="user" value="Usuario" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="35" width="50" height="80" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="Agente IA" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.2;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="480" y="35" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="proc" value="Procesa petición" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="db" value="Base de datos" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="510" y="350" width="140" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="¿Me preparas un plato con pescado?" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=14;verticalAlign=bottom;labelBackgroundColor=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="agent">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="-4" /></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="Respuesta" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#b85450;fontSize=14;verticalAlign=top;labelBackgroundColor=none;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="user">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" y="4" /></mxGeometry>
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;" edge="1" parent="1" source="agent" target="proc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="Consulta base de datos" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=14;labelPosition=left;align=right;labelBackgroundColor=none;" edge="1" parent="1" source="proc" target="db">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="-8" /></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="Resultados" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeWidth=2;strokeColor=#82b366;fontSize=14;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="db" target="agent">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="395" /><mxPoint x="320" y="160" /><mxPoint x="520" y="160" /></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
